# Copy to .env and adjust. Never commit .env.

# --- Postgres ---
POSTGRES_USER=partswagen
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=partswagen
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Backend ---
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
LOG_LEVEL=INFO

# First admin created on startup if no users exist
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=change-me-on-first-login

# --- MinIO / S3 object storage ---
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=partswagen
S3_SECRET_KEY=change-me-in-production
S3_BUCKET=partswagen-photos
S3_REGION=us-east-1

# --- Features ---
OCR_ENABLED=true
VIN_DECODE_ENABLED=true
NHTSA_API_URL=https://vpic.nhtsa.dot.gov/api

# --- Frontend ---
VITE_API_BASE_URL=/api
